{
  "name": "expo-mapbox-nav",
  "version": "2.5.0",
  "description": "Mapbox map + turn-by-turn navigation for Expo (Android + iOS). Navigation runs in TypeScript (Directions API) \u2013 no Navigation SDK, no per-user navigation billing.",
  "main": "build/index.js",
  "react-native": "index.ts",
  "types": "build/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "android/build.gradle",
    "android/src",
    "app.plugin.js",
    "build",
    "expo-module.config.json",
    "index.ts",
    "ios",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsx --test __tests__/*.test.ts"
  },
  "keywords": [
    "android",
    "directions-api",
    "expo",
    "expo-config-plugin",
    "expo-modules",
    "ios",
    "mapbox",
    "mapbox-navigation",
    "navigation",
    "no-navigation-sdk",
    "react-native",
    "turn-by-turn"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AboodyAlaze/mapbox-nav-expo.git",
    "directory": "modules/mapbox-navigation"
  },
  "bugs": {
    "url": "https://github.com/AboodyAlaze/mapbox-nav-expo/issues"
  },
  "homepage": "https://github.com/AboodyAlaze/mapbox-nav-expo#readme",
  "author": "AboodyAlaze",
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=58.0.0",
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-svg": ">=15.0.0",
    "react-native-view-shot": ">=4.0.0",
    "expo-location": ">=58.0.0",
    "expo-speech": ">=58.0.0",
    "expo-keep-awake": ">=58.0.0"
  }
}
