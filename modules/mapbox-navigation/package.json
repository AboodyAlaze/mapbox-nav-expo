{
  "name": "expo-mapbox-nav",
  "version": "1.0.0",
  "description": "Mapbox Navigation SDK v3 for Expo (Android + iOS): turn-by-turn navigation, pressable SVG markers, <Camera/>, dark mode and a 3D vehicle puck.",
  "main": "build/index.js",
  "react-native": "index.ts",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "index.ts",
    "android/build.gradle",
    "android/src",
    "ios",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "expo",
    "expo-modules",
    "expo-config-plugin",
    "react-native",
    "mapbox",
    "mapbox-navigation",
    "turn-by-turn",
    "navigation",
    "android",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AboodyAlaze/mapbox-nav-expo.git",
    "directory": "modules/mapbox-navigation"
  },
  "bugs": {
    "url": "https://github.com/AboodyAlaze/mapbox-nav-expo/issues"
  },
  "homepage": "https://github.com/AboodyAlaze/mapbox-nav-expo#readme",
  "author": "AboodyAlaze",
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=58.0.0",
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-svg": ">=15.0.0",
    "react-native-view-shot": ">=4.0.0"
  }
}
